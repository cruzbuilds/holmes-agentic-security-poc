# Auth: set ONE of these (boto3 picks up either automatically)
# Option A: short-term Bedrock API key
# AWS_BEARER_TOKEN_BEDROCK=
# Option B: AWS profile / SSO (run `aws sso login` first)
# AWS_PROFILE=

AWS_REGION=us-west-2
HOLMES_MODEL_ID=us.anthropic.claude-sonnet-4-6

# Optional: est. price per 1M tokens and manual triage minutes shown in the UI
# HOLMES_PRICE_IN=3
# HOLMES_PRICE_OUT=15
# HOLMES_ANALYST_MINUTES=30
